{
  "name": "angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "test": "ng test",
    "build:lazy-css:portal": "sass --load-path=node_modules --load-path=src/theme/assets/scss src/assets/scss/lazy/bootstrap-portal.scss src/assets/css/lazy/bootstrap-portal.css --no-source-map --style=compressed",
    "build:lazy-css:app": "sass --load-path=node_modules --load-path=src/theme/assets/scss src/assets/scss/lazy/bootstrap-app.scss src/assets/css/lazy/bootstrap-app.css --no-source-map --style=compressed",
    "build:lazy-css": "npm run build:lazy-css:portal && npm run build:lazy-css:app",
    "watch:lazy-css:portal": "sass --watch --load-path=node_modules --load-path=src/theme/assets/scss src/assets/scss/lazy/bootstrap-portal.scss:src/assets/css/lazy/bootstrap-portal.css --no-source-map",
    "watch:lazy-css:app": "sass --watch --load-path=node_modules --load-path=src/theme/assets/scss src/assets/scss/lazy/bootstrap-app.scss:src/assets/css/lazy/bootstrap-app.css --no-source-map",
    "watch:lazy-css": "npm run watch:lazy-css:portal & npm run watch:lazy-css:app",
    "start": "npm run build:lazy-css && ng serve --proxy-config proxy.conf.json  --port 4201",
    "build": "npm run build:lazy-css && ng build",
    "watch": "npm run watch:lazy-css"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/localize": "^21.2.13",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@jsverse/transloco": "^8.3.0",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@ngrx/store": "^21.1.0",
    "@ngx-translate/core": "^17.0.0",
    "@schematics/angular": "^21.2.11",
    "apexcharts": "^5.13.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "echarts": "^6.1.0",
    "ng-apexcharts": "^2.4.0",
    "ngx-cookie-service": "^21.3.1",
    "ngx-countup": "^21.0.0",
    "ngx-lightbox": "^3.0.0",
    "ngx-spinner": "^21.1.0",
    "nouislider": "^15.8.1",
    "rxjs": "~7.8.0",
    "simplebar-angular": "^3.3.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.0",
    "concurrently": "^9.2.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
